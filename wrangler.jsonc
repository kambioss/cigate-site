{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cigate-site",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "worker/index.js",
  // Conserve les variables définies dans le dashboard Cloudflare à chaque déploiement.
  "keep_vars": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cigate",
      "database_id": "82776e69-1343-4e77-9cc0-100b13a344a8"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "14dba657da474392ab327d92c7a926e9"
    }
  ]
}
