{
  "name": "cigate",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "worker": "wrangler dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute cigate --local --file=migrations/0001_news.sql",
    "db:migrate:remote": "wrangler d1 execute cigate --remote --file=migrations/0001_news.sql"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "hono": "^4.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^6.0.0",
    "wrangler": "^4.125.0"
  }
}
